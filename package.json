{
  "name": "nova-foundry-overlook",
  "version": "3.0.0",
  "private": true,
  "description": "Offline bird’s-eye point-and-click reactor incremental game",
  "type": "module",
  "scripts": {
    "build": "esbuild src/main.js --bundle --format=iife --target=es2020 --minify --outfile=assets/game.js && esbuild src/redesign.js --bundle --format=iife --global-name=NovaRedesign --target=es2020 --minify --footer:js=\"NovaRedesign.applyRedesign(window.__NOVA);\" --outfile=assets/redesign.js"
  },
  "dependencies": {
    "three": "0.185.1"
  },
  "devDependencies": {
    "esbuild": "0.28.2"
  }
}
